# App
APP_NAME=BizChat
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://127.0.0.1:5173

# Public URLs (verification links + Google OAuth redirects)
PUBLIC_API_URL=http://localhost:8000
PUBLIC_FRONTEND_URL=http://localhost:5173

# Database
# Local Postgres:
DATABASE_URL=postgresql+asyncpg://bizchat:bizchat@localhost:5432/bizchat
# Cloud Run (SQLite on GCS volume):
# DATABASE_URL=sqlite+aiosqlite:////data/bizchat.db

AUTO_MIGRATE=true
AUTO_SEED=true
# Comma-separated emails always promoted to platform admin on login
PLATFORM_ADMIN_EMAILS=admin@bizchat.local,smailyss1337@gmail.com,mdyl245@gmail.com

# Google OAuth (panel login) — create Web client in Google Cloud Console
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# SMTP (optional). Empty SMTP_HOST → console mailer (logs verification links)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BizChat <noreply@bizchat.local>
SMTP_TLS=true

# Telegram (optional — leave empty for stub outbound)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Meta (Messenger / Instagram)
META_VERIFY_TOKEN=bizchat-verify
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=

# Widget
WIDGET_JWT_SECRET=change-me-widget-secret

# OpenAI (optional — improves intent classification; FAQ/booking work without it)
OPENAI_API_KEY=

# Google Calendar
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=

# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Stripe deposits (optional — mock checkout when empty)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=pln

# Frontend (Vite) — used at build time for Docker image
# VITE_API_URL=http://localhost:8000
